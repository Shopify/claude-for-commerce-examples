# The storefront example's variables. Copy to .env in this directory (or set them in
# the environment). Every value is optional: with none set, the storefront runs
# anonymously against the public demo shop. Never put real credentials in this file.
#
# The merchant example reads merchant/.env first and this file after it, so the
# ANTHROPIC_API_KEY below serves both; its store and token variables are documented
# in merchant/.env.example.

# The shop the backend talks to (UCP discovery resolves the rest).
SHOP_DOMAIN=demostore.mock.shop

# The agent's conversation model.
ANTHROPIC_API_KEY=

# Sign in with Shop — a Dev Dashboard app's credentials; without the pair the
# sign-in routes answer 503 and every session is a guest. Server-side only.
SHOPIFY_UCP_CLIENT_ID=
SHOPIFY_UCP_CLIENT_SECRET=

# The callback URL registered with the app, and where it sends the browser afterwards.
SHOP_OAUTH_REDIRECT_URI=http://localhost:8004/api/auth/shop/callback
WEB_APP_URL=http://localhost:3005

# Headless-dev shortcuts for storefront/scripts/smoke_signin.py (no browser flow).
SHOP_ACCESS_TOKEN=
SHOP_BUYER_IP=

# Web-surface knobs: the hero's static tagline when the shop has no slogan, and the
# startup catalog warm-up (0 disables).
BRAND_TAGLINE=
CATALOG_WARMUP=1
