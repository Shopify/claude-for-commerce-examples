       "merchant_id": "16708973830884969730",
       "merchant_origin": "demostore.mock.shop",
       "auth_jwt": ""
      },
      "allowed_payment_methods": [
       {
        "type": "CARD",
        "parameters": {
         "allowed_auth_methods": [
          "PAN_ONLY",
          "CRYPTOGRAM_3DS"
